{
  "name": "insights",
  "version": "0.1.0",
  "description": "A business dashboard for key analytics values for business",
  "private": true,
  "type": "module",
  "author": "Slava Haikin",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "react-router build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint .",
    "knip": "knip",
    "drizzle:generate": "drizzle-kit generate",
    "prepare": "node -e \"if (require('fs').existsSync('.git')) require('child_process').execSync('npx simple-git-hooks', {stdio: 'inherit'})\""
  },
  "dependencies": {
    "@mantine/core": "^9.3.2",
    "@mantine/hooks": "^9.3.2",
    "@react-router/express": "^7.13.0",
    "@react-router/node": "^7.13.0",
    "argon2": "^0.44.0",
    "aws4fetch": "^1.0.20",
    "better-sqlite3": "^12.4.0",
    "cross-env": "^10.1.0",
    "csv-parse": "^6.2.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.44.0",
    "express": "^4.21.2",
    "isbot": "^5.1.0",
    "lucide-react": "^0.564.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.13.0",
    "recharts": "^3.7.0",
    "tsx": "^4.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^19.8.1",
    "@eslint/js": "^9.39.1",
    "@react-router/dev": "^7.13.0",
    "@stylistic/eslint-plugin": "^5.8.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.39.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.5.0",
    "knip": "^5.86.0",
    "lint-staged": "^15.2.11",
    "simple-git-hooks": "^2.11.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.0",
    "vitest": "^3.2.0"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no-install commitlint --edit \"$1\""
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "eslint --flag v10_config_lookup_from_file --fix"
  },
  "engines": {
    "node": ">=22"
  }
}
