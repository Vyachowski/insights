{
  "name": "insights",
  "version": "0.1.0",
  "description": "A business dashboard for key analytics values for business",
  "private": true,
  "workspaces": [
    "apps/*",
    "contracts"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @insights/backend\" \"npm run dev -w @insights/frontend\"",
    "lint": "npm run lint -w @insights/backend && npm run lint -w @insights/frontend",
    "knip": "knip",
    "prepare": "simple-git-hooks"
  },
  "author": "Slava Haikin",
  "license": "UNLICENSED",
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@commitlint/types": "^19.8.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "knip": "^5.86.0",
    "lint-staged": "^15.2.11",
    "simple-git-hooks": "^2.11.1"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx --no-install commitlint --edit \"$1\""
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": "eslint --flag v10_config_lookup_from_file --fix"
  }
}
