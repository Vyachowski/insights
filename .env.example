# Copy to .env for local development (dev server, Drizzle).

# --- App ---
NODE_ENV=development
PORT=3000
# SQLite database file (default ./data/insights.db; /data/insights.db on Railway)
# DATABASE_PATH=./data/insights.db

# Session cookie signing secret + lifetime (ms)
JWT_SECRET=change-me
JWT_MAX_AGE=604800000

# --- Bucket storage (Railway Bucket / any S3-compatible; optional) ---
# When set, bootstrap CSVs are read from the bucket (seed/cities.csv, seed/sites.csv)
# and daily DB backups are uploaded to backups/insights-YYYY-MM-DD.db
# BUCKET_ENDPOINT=
# BUCKET_NAME=
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
# BUCKET_REGION=auto

# --- Startup bootstrap (runs only against empty tables; steps with missing vars are skipped) ---
# Reference CSVs: Google Drive direct-download format, file shared as "anyone with the link":
# https://drive.google.com/uc?export=download&id=<FILE_ID>
# CITIES_CSV_URL=
# SITES_CSV_URL=
# Initial users:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_LASTNAME=
# USER_EMAIL=
# USER_PASSWORD=
# USER_NAME=
# USER_LASTNAME=
