# Copy to .env for local development (dev server, Drizzle, Docker Compose).

# --- Docker Compose (docker-compose.dev.yml) ---
DB_CONTAINER=insights-pg
DB_USER=insights
DB_PASSWORD=insights
DB_NAME=insights
DB_PORT=5432

# --- App ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://insights:insights@localhost:5432/insights

# Session cookie signing secret + lifetime (ms)
JWT_SECRET=change-me
JWT_MAX_AGE=604800000

# Optional (defaults exist in the env schema)
# DATABASE_CONNECT_RETRIES=5
# DATABASE_CONNECT_DELAY=3000

# --- Startup bootstrap (runs only against empty tables; steps with missing vars are skipped) ---
# Reference CSVs: Google Drive direct-download format, file shared as "anyone with the link":
# https://drive.google.com/uc?export=download&id=<FILE_ID>
# CITIES_CSV_URL=
# SITES_CSV_URL=
# Initial users:
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_LASTNAME=
# USER_EMAIL=
# USER_PASSWORD=
# USER_NAME=
# USER_LASTNAME=
