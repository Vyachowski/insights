# Copy to .env for local development. Keep every production value out of it.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (SQLite file; /data/insights.db on Railway) ---
# DATABASE_PATH=./data/insights.db

# --- Session (cookie signing secret + lifetime in ms) ---
JWT_SECRET=change-me
JWT_MAX_AGE=604800000

# --- Bucket storage (S3-compatible; production only, leave unset locally —
# enables seed CSVs from the bucket and daily DB backups to
# backups/insights-YYYY-MM-DD.db) ---
# BUCKET_ENDPOINT=
# BUCKET_NAME=
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
# BUCKET_REGION=auto

# --- Bootstrap seed CSVs (plain-URL fallback when the bucket is unavailable;
# with no source a new database gets no cities or sites) ---
# CITIES_CSV_URL=
# SITES_CSV_URL=

# --- Bootstrap users (created once on an empty database, only when both the
# admin and the user are set; test values locally) ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_LASTNAME=
# USER_EMAIL=
# USER_PASSWORD=
# USER_NAME=
# USER_LASTNAME=

# --- Gudok call webhook (secret travels in the URL path, Gudok sends no auth;
# leave unset locally, the endpoint then returns 404) ---
# Configure Gudok's project webhook URL to <APP_URL>/webhooks/gudok/<secret>
# GUDOK_WEBHOOK_SECRET=
