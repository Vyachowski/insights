# Settings for `npm run dev:sandbox`. Committed on purpose: every value is a throwaway.
# Keep BUCKET_*, CITIES_CSV_URL and SITES_CSV_URL out: the sandbox must not reach the bucket.

NODE_ENV=development
PORT=3100
DATABASE_PATH=./data/sandbox.db

JWT_SECRET=sandbox-throwaway-secret
JWT_MAX_AGE=604800000

ADMIN_EMAIL=admin@sandbox.test
ADMIN_PASSWORD=sandbox-throwaway-password
ADMIN_NAME=Тест
ADMIN_LASTNAME=Админ

USER_EMAIL=user@sandbox.test
USER_PASSWORD=sandbox-throwaway-user-password
USER_NAME=Тест
USER_LASTNAME=Пользователь

GUDOK_WEBHOOK_SECRET=sandbox-throwaway-webhook
